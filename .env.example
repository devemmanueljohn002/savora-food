# Copy to .env.local (local dev) or set these in your hosting provider's
# environment variables (production). Never commit real secrets.
#
# Base URL of the FRONTEND, used to build links in outgoing emails
# (password reset, email verification) and the Paystack checkout callback.
# Local dev:
APP_URL=http://localhost:3000
# Production: set this to the STABLE production domain from the Vercel
# project settings (NOT a preview/deployment URL — those rotate per deploy).
# Example:
# APP_URL=https://your-stable-domain.vercel.app

# Public site origin for canonical URLs, sitemap, robots and social images.
# Same value as APP_URL in production (falls back to APP_URL when unset).
SITE_URL=https://YOUR_STABLE_PRODUCTION_DOMAIN
# Client-side mirror of SITE_URL (optional; server falls back to SITE_URL/APP_URL).
# NEXT_PUBLIC_SITE_URL=

# Postgres connection string.
DATABASE_URL=

# Session signing secret (long random string).
# JWT_SECRET is the canonical name; AUTH_SECRET is accepted as a legacy alias.
JWT_SECRET=
# AUTH_SECRET=

# JWT/session tuning (optional).
JWT_ISSUER=savora-food
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
API_URL=/api

# Paystack (payments + transfers).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Email provider: set ONE (Brevo preferred, Resend fallback).
BREVO_API_KEY=
RESEND_API_KEY=
# Verified sender identity, e.g. "Savora Food <no-reply@yourdomain.com>".
EMAIL_FROM=

# Google OAuth ("Continue with Google"). Redirect URI on Google Cloud Console:
# {APP_URL}/api/auth/callback/google
# Register BOTH of these redirect URIs in Google Cloud Console:
#   https://YOUR_STABLE_PRODUCTION_DOMAIN/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
# And both authorized JavaScript origins:
#   https://YOUR_STABLE_PRODUCTION_DOMAIN
#   http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Private S3 bucket for vendor profile photos (never public; SSE-S3 default).
# Region MUST match the bucket's actual region or signatures fail.
S3_BUCKET=
S3_REGION=
# Least-privilege IAM user keys (vendors/* + staging/* only; see README/ops notes).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloudinary (optional image uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=

# Seed accounts (optional; used by scripts/seed.ts only).
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=
# RIDER_SEED_EMAIL=
# RIDER_SEED_PASSWORD=
# SUPER_ADMIN_SEED_EMAIL=
# SUPER_ADMIN_SEED_PASSWORD=
# SEED_ADMIN_ONLY=
# ALLOW_DEMO_SEED=

# Cron protection for /api/cron/* (optional but recommended in production).
# CRON_SECRET=
